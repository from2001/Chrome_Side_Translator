{
  "manifest_version": 3,
  "name": "Side Translator",
  "version": "0.1.2",
  "description": "Translate or summarize the main content of the current page in Japanese.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Side Translatorを開く"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
