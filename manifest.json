{
  "manifest_version": 3,
  "name": "Side Translator",
  "version": "0.1.3",
  "description": "Translate or summarize the main content of the current page in Japanese.",
  "homepage_url": "https://github.com/from2001/Chrome_Side_Translator",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Side Translatorを開く",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
